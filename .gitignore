.superpowers/

# Financial statements and exports are ignored everywhere by default
*.csv
*.ofx
*.qfx
*.qbo
*.mt940
*.xls
*.xlsx
*.pdf

# Clearly synthetic fixtures may be tracked deliberately
!/tests/fixtures/synthetic/
!/tests/fixtures/synthetic/**

